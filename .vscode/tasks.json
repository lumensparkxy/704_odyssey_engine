{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Dependencies",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/pip",
			"args": [
				"install",
				"-r",
				"requirements.txt"
			],
			"group": "build",
			"problemMatcher": [],
			"options": {
				"env": {
					"VIRTUAL_ENV": "${workspaceFolder}/.venv",
					"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
				}
			}
		},
		{
			"label": "Run Odyssey Engine",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"main.py"
			],
			"group": "build",
			"dependsOn": "Install Dependencies",
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "new"
			},
			"options": {
				"env": {
					"VIRTUAL_ENV": "${workspaceFolder}/.venv",
					"PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
					"PYTHONPATH": "${workspaceFolder}/src"
				}
			}
		},
		{
			"label": "Run Tests (pytest)",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"pytest",
				"-q"
			],
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Run Pytest Integration",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"pytest",
				"-q",
				"-ra",
				"-m",
				"integration",
				"tests/test_intent_analyzer_integration.py"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}