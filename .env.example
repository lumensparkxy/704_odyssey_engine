# Odyssey Engine - Environment Configuration

# Required: Gemini API Key
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model (default: gemini-3-flash-preview)
# Options: gemini-3-flash-preview, gemini-2.5-pro, gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Reports output directory (default: ./reports)
REPORTS_OUTPUT_PATH=./reports
